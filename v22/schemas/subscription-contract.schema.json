{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V22 Subscription Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "display_name",
    "billing_cadence",
    "billing_currency",
    "benefits",
    "delivery_model",
    "entitlement_authority",
    "renewal_disclosure",
    "cancellation_disclosure",
    "period_grant_key",
    "reconciliation_owner",
    "no_gambling",
    "no_paid_random_outcomes",
    "no_hidden_gates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "billing_cadence": {
      "const": "monthly"
    },
    "billing_currency": {
      "enum": [
        "Robux",
        "local_currency"
      ]
    },
    "benefits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "delivery_model": {
      "enum": [
        "monthly",
        "continuous_term_access",
        "hybrid"
      ]
    },
    "entitlement_authority": {
      "const": "server_confirmed"
    },
    "renewal_disclosure": {
      "type": "string",
      "minLength": 20
    },
    "cancellation_disclosure": {
      "type": "string",
      "minLength": 20
    },
    "period_grant_key": {
      "type": "string",
      "minLength": 3
    },
    "reconciliation_owner": {
      "type": "string",
      "minLength": 2
    },
    "no_gambling": {
      "const": true
    },
    "no_paid_random_outcomes": {
      "const": true
    },
    "no_hidden_gates": {
      "const": true
    }
  }
}
