{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V22 Pricing Readiness Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_root",
    "summary",
    "findings",
    "next_steps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_considered",
        "files_scanned",
        "files_skipped_oversize",
        "files_unreadable",
        "scan_truncated",
        "max_files",
        "hard_coded_price_literals",
        "dynamic_price_lookup_sites",
        "legacy_product_info_sites",
        "price_level_api_sites",
        "subscription_api_sites"
      ],
      "properties": {
        "files_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "hard_coded_price_literals": {
          "type": "integer",
          "minimum": 0
        },
        "dynamic_price_lookup_sites": {
          "type": "integer",
          "minimum": 0
        },
        "price_level_api_sites": {
          "type": "integer",
          "minimum": 0
        },
        "subscription_api_sites": {
          "type": "integer",
          "minimum": 0
        },
        "files_considered": {
          "type": "integer",
          "minimum": 0
        },
        "files_skipped_oversize": {
          "type": "integer",
          "minimum": 0
        },
        "files_unreadable": {
          "type": "integer",
          "minimum": 0
        },
        "scan_truncated": {
          "type": "boolean"
        },
        "max_files": {
          "type": "integer",
          "minimum": 1
        },
        "legacy_product_info_sites": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "line",
          "severity",
          "evidence",
          "message"
        ],
        "properties": {
          "code": {
            "enum": [
              "HARDCODED_PRICE_LITERAL",
              "DYNAMIC_PRICE_LOOKUP",
              "PRICE_LEVEL_API",
              "SUBSCRIPTION_API",
              "LEGACY_PRODUCT_INFO_API"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "severity": {
            "enum": [
              "review",
              "info"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
