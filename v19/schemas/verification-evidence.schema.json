{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-codex/v19/verification-evidence.schema.json",
  "title": "V19 Verification Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_item_id", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "work_item_id": {"type": "string", "minLength": 3},
    "build_identity": {"type": "string"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "category", "status", "environment", "tool_version", "command", "expected", "actual", "evidence_paths", "limitations"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "category": {"enum": ["format", "static", "unit", "integration", "studio", "multiplayer", "device", "performance", "persistence", "economy", "security", "release", "live-service", "other"]},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "NOT_APPLICABLE"]},
          "environment": {"type": "string"},
          "tool_version": {"type": "string"},
          "command": {"type": "string"},
          "expected": {"type": "string"},
          "actual": {"type": "string"},
          "evidence_paths": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "scenario": {"type": "string"}
        }
      }
    }
  }
}
