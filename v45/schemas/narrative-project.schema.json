{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roblox narrative project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "build_id",
    "default_locale",
    "supported_locales",
    "quests",
    "dialogues"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "$ref": "#/$defs/slug"
    },
    "build_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "default_locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "supported_locales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
      }
    },
    "quests": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/quest"
      }
    },
    "dialogues": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/dialogue"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,47}$"
    },
    "quest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quest_id",
        "title",
        "summary",
        "repeat_policy",
        "prerequisites",
        "start_node_id",
        "nodes"
      ],
      "properties": {
        "quest_id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 100
        },
        "summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        },
        "repeat_policy": {
          "enum": [
            "once",
            "repeatable"
          ]
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "start_node_id": {
          "$ref": "#/$defs/slug"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/questNode"
          }
        }
      }
    },
    "questNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "kind",
        "title",
        "objective_type",
        "next_node_ids"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "enum": [
            "objective",
            "branch",
            "complete"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "objective_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "talk",
            "interact",
            "collect",
            "deliver",
            "explore",
            "wait",
            "custom",
            null
          ]
        },
        "next_node_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "dialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "title",
        "start_node_id",
        "nodes"
      ],
      "properties": {
        "conversation_id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "start_node_id": {
          "$ref": "#/$defs/slug"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/dialogueNode"
          }
        }
      }
    },
    "dialogueNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "kind",
        "speaker",
        "text_key",
        "text",
        "choices"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "enum": [
            "line",
            "end"
          ]
        },
        "speaker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "text_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "choices": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/choice"
          }
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choice_id",
        "label_key",
        "label",
        "next_node_id"
      ],
      "properties": {
        "choice_id": {
          "$ref": "#/$defs/slug"
        },
        "label_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "next_node_id": {
          "$ref": "#/$defs/slug"
        }
      }
    }
  }
}
