{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V38 Roblox Incident Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","incident_id","project_key","opened_at","detected_at","severity","status","summary","impact","detection","roles","timeline","actions","communications","resolution"],
  "properties": {
    "schema_version": {"const": 1},
    "incident_id": {"type":"string","pattern":"^inc-[a-z0-9]{8,24}$"},
    "project_key": {"type":"string","pattern":"^[a-z0-9][a-z0-9_-]{1,62}$"},
    "opened_at": {"type":"string","format":"date-time"},
    "detected_at": {"type":"string","format":"date-time"},
    "severity": {"enum":["critical","high","moderate","low"]},
    "status": {"enum":["investigating","mitigating","monitoring","resolved"]},
    "summary": {"type":"string","minLength":10,"maxLength":500},
    "impact": {
      "type":"object","additionalProperties":false,
      "required":["services","audience_scope","impact_summary","privacy_reviewed"],
      "properties":{
        "services":{"type":"array","minItems":1,"maxItems":10,"uniqueItems":true,"items":{"enum":["data_store","economy","matchmaking","networking","gameplay","content_delivery","publishing","analytics","moderation","unknown"]}},
        "audience_scope":{"enum":["all_players","aggregate_subset","unknown"]},
        "impact_summary":{"type":"string","minLength":10,"maxLength":800},
        "privacy_reviewed":{"const":true}
      }
    },
    "detection":{
      "type":"object","additionalProperties":false,
      "required":["source","signal_refs","privacy_safe"],
      "properties":{
        "source":{"enum":["aggregate_telemetry","aggregated_player_reports","developer_observation","platform_status","other"]},
        "signal_refs":{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"items":{"type":"string","pattern":"^sig-[a-z0-9]{8,24}$"}},
        "privacy_safe":{"const":true}
      }
    },
    "roles":{"type":"array","minItems":1,"maxItems":4,"items":{"type":"object","additionalProperties":false,"required":["role","acknowledged"],"properties":{"role":{"enum":["incident_commander","technical_lead","data_owner","communications_lead"]},"acknowledged":{"type":"boolean"}}}},
    "timeline":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["event_id","occurred_at","event_type","summary","evidence_refs"],"properties":{"event_id":{"type":"string","pattern":"^evt-[a-z0-9]{8,24}$"},"occurred_at":{"type":"string","format":"date-time"},"event_type":{"enum":["detected","triaged","investigation","mitigation","verification","communication","resolved"]},"summary":{"type":"string","minLength":5,"maxLength":500},"evidence_refs":{"type":"array","maxItems":30,"uniqueItems":true,"items":{"type":"string","pattern":"^ev-[a-z0-9]{12}$"}}}}},
    "actions":{"type":"array","maxItems":50,"items":{"type":"object","additionalProperties":false,"required":["action_id","category","description","risk","status","requires_approval","approval_ref","approved_at","created_at","verification_status","verification_ref"],"properties":{"action_id":{"type":"string","pattern":"^act-[a-z0-9]{8,24}$"},"category":{"enum":["observe","mitigate","rollback","restore","communicate"]},"description":{"type":"string","minLength":1,"maxLength":500},"risk":{"enum":["low","medium","high"]},"status":{"enum":["proposed","approved","applied","rejected","reverted"]},"requires_approval":{"type":"boolean"},"approval_ref":{"type":["string","null"],"pattern":"^apr-[a-z0-9]{8,24}$"},"approved_at":{"type":["string","null"],"format":"date-time"},"created_at":{"type":"string","format":"date-time"},"verification_status":{"enum":["not_run","pass","fail"]},"verification_ref":{"type":["string","null"],"pattern":"^ev-[a-z0-9]{12}$"}}}},
    "communications":{"type":"object","additionalProperties":false,"required":["player_notice_required","player_notice_reviewed","privacy_safe","player_notice_ref"],"properties":{"player_notice_required":{"type":"boolean"},"player_notice_reviewed":{"type":"boolean"},"privacy_safe":{"const":true},"player_notice_ref":{"type":["string","null"],"pattern":"^msg-[a-z0-9]{8,24}$"}}},
    "resolution":{"type":"object","additionalProperties":false,"required":["resolved_at","verification_ref","postmortem_ref","follow_up_ref","customer_impact_closed"],"properties":{"resolved_at":{"type":["string","null"],"format":"date-time"},"verification_ref":{"type":["string","null"],"pattern":"^ev-[a-z0-9]{12}$"},"postmortem_ref":{"type":["string","null"],"pattern":"^pm-[a-z0-9]{8,24}$"},"follow_up_ref":{"type":["string","null"],"pattern":"^issue-[a-z0-9]{8,24}$"},"customer_impact_closed":{"type":"boolean"}}}
  }
}
