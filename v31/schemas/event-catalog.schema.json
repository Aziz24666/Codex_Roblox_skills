{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aziz24666/Codex_Roblox_skills/blob/main/v31/schemas/event-catalog.schema.json",
  "title": "V31 custom analytics event catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "events"],
  "properties": {
    "schema_version": { "const": 1 },
    "events": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "method", "purpose", "privacy_reviewed", "fields"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
          "method": { "const": "LogCustomEvent" },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 240 },
          "privacy_reviewed": { "const": true },
          "fields": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "slot", "allowed_values"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
                "slot": { "enum": ["CustomField01", "CustomField02", "CustomField03"] },
                "allowed_values": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 256,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1, "maxLength": 48 }
                }
              }
            }
          }
        }
      }
    },
    "telemetry_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_calls_per_minute", "maximum_concurrent_users"],
      "properties": {
        "expected_calls_per_minute": { "type": "integer", "minimum": 1 },
        "maximum_concurrent_users": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
