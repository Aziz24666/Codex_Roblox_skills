{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-codex/v15/runtime-evidence.schema.json",
  "title": "V15 Runtime Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "environment", "scenario_id", "status", "started_at"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "environment": {"enum": ["static", "luau-cli", "rojo-build", "studio", "device-simulator", "physical-device", "staging-service", "production"]},
    "scenario_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "NOT_APPLICABLE"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "client_count": {"type": "integer", "minimum": 0},
    "device_preset": {"type": "string"},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "logs": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
