{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-codex/v15/task-evaluation.schema.json",
  "title": "V15 Task Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "selected_skills", "criteria", "result"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "selected_skills": {"type": "array", "items": {"type": "string"}},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "status"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "NOT_APPLICABLE"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"}
        }
      }
    },
    "result": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
    "notes": {"type": "string"}
  }
}
