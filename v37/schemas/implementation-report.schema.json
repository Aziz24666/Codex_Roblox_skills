{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V37 Implementation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "generated_at",
    "task_results"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^impl-plan-[a-z0-9]{8,24}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "$ref": "#/$defs/taskResult"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\\\\\)(?!.*[*?\\[\\]{}]).+$"
    },
    "evidence": {
      "type": "string",
      "pattern": "^ev-[a-z0-9]{12}$"
    },
    "taskResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "changed_files",
        "evidence_refs",
        "criteria_results"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
        },
        "status": {
          "enum": [
            "completed",
            "in_progress",
            "blocked",
            "not_started"
          ]
        },
        "changed_files": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "criteria_results": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/criterionResult"
          }
        }
      }
    },
    "criterionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "result"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        }
      }
    }
  }
}
