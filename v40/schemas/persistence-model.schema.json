{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"V40 Roblox Persistence Contract",
  "type":"object","additionalProperties":false,
  "required":["schema_version","model_id","profile_store","session","saving","fields","migrations","transactions"],
  "properties":{
    "schema_version":{"const":1},
    "model_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{1,39}$"},
    "profile_store":{"type":"object","additionalProperties":false,"required":["store_name","scope","schema_version","minimum_supported_version","key_strategy","profile_size_budget_bytes"],"properties":{
      "store_name":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,50}$"},
      "scope":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,50}$"},
      "schema_version":{"type":"integer","minimum":1,"maximum":1000},
      "minimum_supported_version":{"type":"integer","minimum":1,"maximum":1000},
      "key_strategy":{"const":"user_id_key"},
      "profile_size_budget_bytes":{"type":"integer","minimum":65536,"maximum":4000000}
    }},
    "session":{"type":"object","additionalProperties":false,"required":["locking_enabled","lock_method","lease_seconds","refresh_interval_seconds","wait_on_conflict","fail_closed_on_uncertain_ownership","owner_token_required","release_on_player_removal","release_on_shutdown"],"properties":{
      "locking_enabled":{"const":true},"lock_method":{"enum":["SessionLockedDataStoreWrapper","UpdateAsync_lease"]},
      "lease_seconds":{"type":"integer","minimum":30,"maximum":900},
      "refresh_interval_seconds":{"type":"integer","minimum":1,"maximum":450},
      "wait_on_conflict":{"const":true},"fail_closed_on_uncertain_ownership":{"const":true},
      "owner_token_required":{"const":true},"release_on_player_removal":{"const":true},"release_on_shutdown":{"const":true}
    }},
    "saving":{"type":"object","additionalProperties":false,"required":["write_method","autosave_interval_seconds","shutdown_budget_seconds","retry_attempts","initial_backoff_ms","max_backoff_ms","exponential_backoff","jitter","serialize_writes_per_key","budget_aware","stagger_autosaves","save_on_leave","flush_on_shutdown","unknown_write_outcome"],"properties":{
      "write_method":{"const":"UpdateAsync"},
      "autosave_interval_seconds":{"type":"integer","minimum":30,"maximum":600},
      "shutdown_budget_seconds":{"type":"integer","minimum":1,"maximum":25},
      "retry_attempts":{"type":"integer","minimum":1,"maximum":8},
      "initial_backoff_ms":{"type":"integer","minimum":100,"maximum":5000},
      "max_backoff_ms":{"type":"integer","minimum":100,"maximum":30000},
      "exponential_backoff":{"const":true},"jitter":{"const":true},"serialize_writes_per_key":{"const":true},
      "budget_aware":{"const":true},"stagger_autosaves":{"const":true},"save_on_leave":{"const":true},"flush_on_shutdown":{"const":true},
      "unknown_write_outcome":{"const":"reload_and_reconcile"}
    }},
    "fields":{"type":"array","minItems":1,"maxItems":128,"items":{"type":"object","additionalProperties":false,"required":["field_id","data_type","category","default_value","max_encoded_bytes","client_mutable","server_validation_required"],"properties":{
      "field_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{1,39}$"},
      "data_type":{"enum":["integer","number","string","boolean","array","object"]},
      "category":{"enum":["gameplay_currency","progression","inventory","cosmetic","setting","transaction_ledger","session_metadata"]},
      "default_value":{},
      "max_encoded_bytes":{"type":"integer","minimum":1,"maximum":4000000},
      "client_mutable":{"type":"boolean"},"server_validation_required":{"type":"boolean"}
    }}},
    "migrations":{"type":"array","maxItems":99,"items":{"type":"object","additionalProperties":false,"required":["migration_id","from_version","to_version","idempotent","backup_required","dry_run_required","preserve_unknown_fields","rollback_strategy","test_case_ids"],"properties":{
      "migration_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{1,39}$"},
      "from_version":{"type":"integer","minimum":1,"maximum":999},"to_version":{"type":"integer","minimum":2,"maximum":1000},
      "idempotent":{"const":true},"backup_required":{"const":true},"dry_run_required":{"const":true},"preserve_unknown_fields":{"const":true},
      "rollback_strategy":{"enum":["restore_backup","forward_fix","manual_only"]},
      "test_case_ids":{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_-]{1,39}$"}}
    }}},
    "transactions":{"type":"array","maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["operation_id","transaction_kind","idempotency_key_source","dedupe_field_id","commit_strategy","same_update_contains_effect_and_marker","acknowledge_after_commit","concurrent_delivery_policy","unknown_outcome_policy"],"properties":{
      "operation_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{1,39}$"},
      "transaction_kind":{"enum":["developer_product_receipt","gameplay_reward","inventory_exchange"]},
      "idempotency_key_source":{"enum":["PurchaseId","server_operation_id"]},
      "dedupe_field_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{1,39}$"},
      "commit_strategy":{"const":"single_profile_key_UpdateAsync"},
      "same_update_contains_effect_and_marker":{"const":true},
      "acknowledge_after_commit":{"const":true},
      "concurrent_delivery_policy":{"const":"serialized_UpdateAsync_per_key"},
      "unknown_outcome_policy":{"const":"reload_reconcile_retry_same_key"}
    }}}
  }
}
