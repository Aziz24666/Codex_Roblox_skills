{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V35 Roblox Asset Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "project_key",
    "generated_at",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^asset-catalog-[a-z0-9]{8,24}$"
    },
    "project_key": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z0-9][a-z0-9_-]{1,62}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_key",
          "kind",
          "source_kind",
          "ownership_scope",
          "rights_status",
          "moderation_status",
          "lifecycle",
          "version",
          "dependencies",
          "targets",
          "measurements",
          "provenance_ref"
        ],
        "properties": {
          "asset_key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
          },
          "kind": {
            "enum": [
              "model",
              "mesh",
              "texture",
              "image",
              "audio",
              "animation",
              "package",
              "other"
            ]
          },
          "source_kind": {
            "enum": [
              "local_source",
              "studio_created",
              "creator_store",
              "external"
            ]
          },
          "source_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "provider_asset_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "ownership_scope": {
            "enum": [
              "group",
              "account",
              "third_party",
              "unknown"
            ]
          },
          "rights_status": {
            "enum": [
              "cleared",
              "pending",
              "restricted",
              "unknown"
            ]
          },
          "moderation_status": {
            "enum": [
              "approved",
              "pending",
              "rejected",
              "not_applicable"
            ]
          },
          "lifecycle": {
            "enum": [
              "draft",
              "review",
              "approved",
              "released",
              "deprecated"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "dependencies": {
            "type": "array",
            "maxItems": 200,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "enum": [
                "low_end_mobile",
                "mobile",
                "desktop",
                "console",
                "vr",
                "server"
              ]
            }
          },
          "measurements": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file_size_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "texture_width_px": {
                "type": "integer",
                "minimum": 1
              },
              "texture_height_px": {
                "type": "integer",
                "minimum": 1
              },
              "mesh_triangles": {
                "type": "integer",
                "minimum": 1
              },
              "audio_duration_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "animation_keyframes": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "provenance_ref": {
            "type": "string",
            "pattern": "^ev-[a-z0-9]{12}$"
          },
          "review_ref": {
            "type": "string",
            "pattern": "^ev-[a-z0-9]{12}$"
          }
        }
      }
    }
  }
}
