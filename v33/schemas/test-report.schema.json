{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-codex/v33/test-report.schema.json",
  "title": "V33 Roblox QA Run Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "run_ref", "created_at", "environment", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "suite_id": {"type": "string", "pattern": "^suite-[a-z0-9]{8,24}$"},
    "run_ref": {"type": "string", "pattern": "^run-[a-z0-9]{12}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "studio_version", "platform", "network_profile", "simulated_clients"],
      "properties": {
        "runner": {"enum": ["studio_plugin", "studio_manual", "local_static"]},
        "studio_version": {"type": "string", "maxLength": 80},
        "platform": {"enum": ["desktop", "mobile", "tablet", "console", "vr"]},
        "network_profile": {"enum": ["baseline", "high_latency", "jitter", "packet_loss"]},
        "simulated_clients": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "status", "outcome_code", "executed_at"],
        "properties": {
          "test_id": {"type": "string", "pattern": "^TC-[A-Z0-9-]{3,24}$"},
          "status": {"enum": ["pass", "fail", "blocked", "not_run"]},
          "outcome_code": {"enum": ["passed", "assertion_failed", "unhandled_error", "timeout", "state_divergence", "ui_input_missing", "data_roundtrip_failed", "remote_validation_failed", "network_disconnect", "studio_unavailable", "setup_incomplete", "device_profile_unavailable", "not_executed"]},
          "executed_at": {"type": ["string", "null"], "format": "date-time"},
          "evidence_ref": {"type": "string", "pattern": "^ev-[a-z0-9]{12}$"}
        }
      }
    }
  }
}
