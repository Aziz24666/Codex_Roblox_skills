{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V33 Roblox QA Test Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "max_simulated_clients", "platforms", "network_profiles", "tests"],
  "properties": {
    "schema_version": {"const": 1},
    "suite_id": {"type": "string", "pattern": "^suite-[a-z0-9]{8,24}$"},
    "max_simulated_clients": {"type": "integer", "minimum": 1, "maximum": 8},
    "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["desktop", "mobile", "tablet", "console", "vr"]}},
    "network_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["baseline", "high_latency", "jitter", "packet_loss"]}},
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenario", "category", "priority", "execution", "clients", "platforms", "expected"],
        "properties": {
          "id": {"type": "string", "pattern": "^TC-[A-Z0-9-]{3,24}$"},
          "scenario": {"enum": ["baseline_smoke", "fresh_join", "respawn", "mid_session_join", "mid_session_leave", "rapid_join_leave", "multi_client_replication", "remote_validation", "ui_open_close", "touch_navigation", "controller_navigation", "orientation_change", "keyboard_open_close", "network_latency", "network_jitter", "network_packet_loss", "save_reload", "cross_device_layout"]},
          "category": {"enum": ["smoke", "lifecycle", "multiplayer", "security", "ui", "device", "networking", "persistence"]},
          "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "execution": {"enum": ["static_local", "studio_manual", "studio_scripted"]},
          "clients": {"type": "integer", "minimum": 1, "maximum": 8},
          "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["desktop", "mobile", "tablet", "console", "vr"]}},
          "expected": {"enum": ["no_unhandled_errors", "state_consistent", "players_replicated", "invalid_request_rejected", "ui_action_received", "layout_usable", "orientation_adapted", "input_received", "session_recovered", "data_round_trip"]}
        }
      }
    }
  }
}
