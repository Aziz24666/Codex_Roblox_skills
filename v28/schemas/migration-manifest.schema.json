{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-roblox/v28/migration-manifest.schema.json",
  "title": "V28 Safe Data Migration Review Manifest",
  "type": "object",
  "required": ["schema_version", "environment", "dry_run", "production_writes", "current_schema_version", "target_schema_version", "preserve_unknown_fields", "backup", "rollback_plan", "migrations"],
  "properties": {
    "schema_version": {"const": 1},
    "environment": {"enum": ["synthetic", "staging"]},
    "dry_run": {"const": true},
    "production_writes": {"const": false},
    "current_schema_version": {"type": "integer", "minimum": 1},
    "target_schema_version": {"type": "integer", "minimum": 2},
    "preserve_unknown_fields": {"const": true},
    "backup": {
      "type": "object",
      "required": ["required", "verified_in_staging", "strategy"],
      "properties": {
        "required": {"const": true},
        "verified_in_staging": {"const": true},
        "strategy": {"type": "string", "minLength": 8}
      }
    },
    "rollback_plan": {"type": "string", "minLength": 20},
    "migrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to", "idempotent", "description", "tests"],
        "properties": {
          "from": {"type": "integer", "minimum": 1},
          "to": {"type": "integer", "minimum": 2},
          "idempotent": {"const": true},
          "description": {"type": "string", "minLength": 8},
          "tests": {"type": "array", "minItems": 4}
        }
      }
    }
  }
}
