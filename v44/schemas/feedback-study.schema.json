{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-codex/v44/feedback-study.schema.json",
  "title": "V44 Feedback Study",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","study_id","title","purpose","method","build","window","target","notice","questions"],
  "properties": {
    "schema_version": {"type":"integer","const":1},
    "study_id": {"type":"string","pattern":"^[a-z][a-z0-9_-]{1,39}$"},
    "title": {"type":"string","minLength":4,"maxLength":100,"pattern":".*\\S.*"},
    "purpose": {"type":"string","minLength":20,"maxLength":500,"pattern":".*\\S.*"},
    "method": {"enum":["moderated_playtest","structured_survey","support_summary"]},
    "build": {
      "type":"object","additionalProperties":false,"required":["build_id","environment"],
      "properties":{
        "build_id":{"type":"string","minLength":1,"maxLength":60,"pattern":".*\\S.*"},
        "environment":{"enum":["private_test","staging","published"]}
      }
    },
    "window":{
      "type":"object","additionalProperties":false,"required":["starts_at","ends_at"],
      "properties":{"starts_at":{"type":"string","format":"date-time"},"ends_at":{"type":"string","format":"date-time"}}
    },
    "target":{
      "type":"object","additionalProperties":false,"required":["minimum_responses","maximum_responses","small_cell_threshold"],
      "properties":{
        "minimum_responses":{"type":"integer","minimum":5,"maximum":5000},
        "maximum_responses":{"type":"integer","minimum":5,"maximum":10000},
        "small_cell_threshold":{"type":"integer","minimum":3,"maximum":20}
      }
    },
    "notice":{
      "type":"object","additionalProperties":false,
      "required":["purpose_disclosed","voluntary","skip_allowed","data_minimized","no_identifiers","no_free_text","retention_days","owner_role"],
      "properties":{
        "purpose_disclosed":{"const":true},"voluntary":{"const":true},"skip_allowed":{"const":true},
        "data_minimized":{"const":true},"no_identifiers":{"const":true},"no_free_text":{"const":true},
        "retention_days":{"type":"integer","minimum":1,"maximum":90},
        "owner_role":{"type":"string","minLength":2,"maxLength":60,"pattern":".*\\S.*"}
      }
    },
    "questions":{
      "type":"array","minItems":1,"maxItems":20,
      "items":{
        "type":"object","additionalProperties":false,"required":["question_id","topic","prompt"],
        "properties":{
          "question_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{1,39}$"},
          "topic":{"enum":["onboarding","core_loop","progression","interface","controls","performance","social","accessibility","monetization","other"]},
          "prompt":{"type":"string","minLength":8,"maxLength":240,"pattern":".*\\S.*"}
        }
      }
    }
  }
}
